# KernelSU Next + susfs fragment for Pixel 4 (coral)
# Appended to arch/arm64/configs/floral_defconfig (coral uses floral defconfig)

# Symbol tables required for KSU check_symbol validator
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y

# Disable -Werror globally. 4.14 msm is EOL; gcc 11/12 produces many
# false-positive warnings (-Warray-bounds, -Wmaybe-uninitialized,
# -Wmisleading-indentation, -Wzero-length-bounds, -Wstringop-overread)
# in arm64 inline asm and pre-existing code. Turning warnings into
# errors blocks every build with newer gcc. Build continues on
# warnings; only hard errors (undeclared, syntax) still fail.
# CONFIG_WERROR is not set

# Force gcc build (avoid clang/LTO complexity on 4.14 msm)
# Use kbuild's "is not set" syntax for =n entries — defconfig parser
# ignores plain "=n" in some symbols; "# X is not set" is the
# canonical form.
CONFIG_LTO_NONE=y
# CONFIG_LTO is not set
# CONFIG_LTO_CLANG is not set
# CONFIG_CFI_CLANG is not set
# CONFIG_CFI is not set
# SHADOW_CALL_STACK is inside a choice block — disable the whole ROP
# protection choice by selecting ROP_PROTECTION_NONE.
# CONFIG_SHADOW_CALL_STACK is not set
CONFIG_ROP_PROTECTION_NONE=y
# Disable stack protector entirely — gcc 11 in this build environment
# doesn't pass the kbuild "broken stack-protector" check at
# Makefile:1269. -fno-stack-protector is universally supported.
CONFIG_CC_STACKPROTECTOR_NONE=y
# CONFIG_CC_STACKPROTECTOR_REGULAR is not set
# CONFIG_CC_STACKPROTECTOR_STRONG is not set
# CONFIG_CC_STACKPROTECTOR_AUTO is not set
# CONFIG_STACKPROTECTOR is not set

# --- KSU Core (legacy branch, manual hooks) ---
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y
CONFIG_KSU_KPROBES_HOOK=n

# --- susfs (built into KSU Next v3.1.0-legacy-susfs tag) ---
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_HAS_MAGIC_MOUNT=n
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SUS_OVERLAYFS=n
CONFIG_KSU_SUSFS_TRY_UMOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_TRY_UMOUNT_FOR_BIND_MOUNT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
