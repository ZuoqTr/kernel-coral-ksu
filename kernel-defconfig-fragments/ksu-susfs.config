# KernelSU Next + susfs fragment for Pixel 4 (coral)
# Appended to arch/arm64/configs/floral_defconfig (coral uses floral defconfig)

# Symbol tables required for KSU check_symbol validator
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y

# --- Clang LTO/CFI: explicit disable for 4.14 msm ---
# 4.14's kbuild only recognises clang up to version 9.x. apt clang 14
# fails the version regex in arch/arm64/Makefile's LTO_CLANG prepare
# check ("Cannot use CONFIG_LTO_CLANG: requires clang 5.0 or later").
# We don't need LTO anyway; disable LTO + CFI explicitly.
CONFIG_LTO_NONE=y
# CONFIG_LTO is not set
# CONFIG_LTO_CLANG is not set
# CONFIG_CFI_CLANG is not set
# CONFIG_CFI is not set

# --- KSU Core (legacy branch, manual hooks) ---
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y
CONFIG_KSU_KPROBES_HOOK=n

# --- susfs (built into KSU Next v3.1.0-legacy-susfs tag) ---
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_HAS_MAGIC_MOUNT=n
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SUS_OVERLAYFS=n
CONFIG_KSU_SUSFS_TRY_UMOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_TRY_UMOUNT_FOR_BIND_MOUNT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y