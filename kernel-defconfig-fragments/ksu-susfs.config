# KernelSU Next fragment for Pixel 4 (coral)
# Manual hooks: v3.1.0-legacy branch (kprobes unavailable on 4.14 msm).
# 5 syscall sites patched by patches/ksu-manual-hooks/.

CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y

# KSU core (manual hooks mode)
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y
CONFIG_KSU_KPROBES_HOOK=n

# SUSFS disabled. The external susfs4ksu kernel patches
# (patches/susfs-kernel-4.14/0001-combined.patch) are written for a
# post-4.18 IDA-API kernel and do NOT apply cleanly to this 4.14 msm
# source tree (which uses pre-4.18 ida_pre_get/ida_get_new_above/
# ida_remove). Disabling CONFIG_KSU_SUSFS prevents the in-tree
# susfs_* extern calls from being referenced — KSU still functions,
# but mount-path / kstat hiding is unavailable. For a defensive test
# build of KSU itself this is acceptable; the user can re-enable
# susfs later by applying a correctly-anchored patch series against
# the actual msm-4.14 IDA API.
CONFIG_KSU_SUSFS=n