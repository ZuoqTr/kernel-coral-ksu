# KernelSU Next + susfs fragment for Pixel 4 (coral)
# Appended to arch/arm64/configs/floral_defconfig (coral uses floral defconfig)

# Symbol tables required for KSU check_symbol validator
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y

# --- ROP / shadow-call-stack: disable for 4.14 + clang 14 ---
# kbuild's prepare-compiler-check probes -fsanitize=shadow-call-stack
# and fails: 'Cannot use CONFIG_SHADOW_CALL_STACK: ... not supported
# by compiler'. Disable the whole ROP_PROTECTION choice.
CONFIG_ROP_PROTECTION_NONE=y
# CONFIG_SHADOW_CALL_STACK is not set

# --- Clang LTO/CFI: explicit disable for 4.14 msm ---
# 4.14's kbuild only recognises clang up to version 9.x. apt clang 14
# fails the version regex in arch/arm64/Makefile's LTO_CLANG prepare
# check ("Cannot use CONFIG_LTO_CLANG: requires clang 5.0 or later").
# We don't need LTO anyway; disable LTO + CFI explicitly.
CONFIG_LTO_NONE=y
# CONFIG_LTO is not set
# CONFIG_LTO_CLANG is not set
# CONFIG_CFI_CLANG is not set
# CONFIG_CFI is not set

# --- Stack protector: disable for clang 14 + 4.14 msm ---
# kbuild's prepare-compiler-check probes
# `clang -fstack-protector-strong ...` and fails with
# "Cannot use CONFIG_CC_STACKPROTECTOR_STRONG: -fstack-protector-strong
# not supported by compiler". Clang 14 does support the flag, but the
# 4.14 msm kbuild shell test invokes $(CC) which under our env
# resolves to the apt gcc-11 binary through CROSS_COMPILE precedence,
# and that test path doesn't recognise clang's stack-protector-strong.
# Safer to disable the whole stack-protector choice.
CONFIG_CC_STACKPROTECTOR_NONE=y
# CONFIG_CC_STACKPROTECTOR_REGULAR is not set
# CONFIG_CC_STACKPROTECTOR_STRONG is not set
# CONFIG_CC_STACKPROTECTOR_AUTO is not set
# CONFIG_STACKPROTECTOR is not set

# --- KSU Core (legacy branch, manual hooks) ---
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y
CONFIG_KSU_KPROBES_HOOK=n

# --- susfs (built into KSU Next v3.1.0-legacy-susfs tag) ---
# Disabled: susfs kernel-tree patches from devnoname120/susfs4ksu-toco
# kernel-4.14-backport don't apply cleanly to coral's
# android-msm-coral-4.14-android10-qpr3 source. KSU itself works
# without susfs; just no path/mount hiding.
# CONFIG_KSU_SUSFS is not set